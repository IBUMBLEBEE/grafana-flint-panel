{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ibumblebee.github.io/flint-ai/request-v1.schema.json",
  "title": "Flint AI datasource request contract v1",
  "$defs": {
    "generate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            },
            "required": ["name", "type"]
          }
        },
        "dataHint": {
          "type": "string"
        },
        "suggestedChartType": {
          "type": "string"
        },
        "renderBackend": {
          "enum": ["echarts", "vegalite", "chartjs", "plotly"]
        },
        "chartCatalog": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "chartType": {
                "type": "string"
              },
              "channels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "requiredChannels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "properties": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "type": {
                      "enum": ["continuous", "discrete", "binary"]
                    },
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    },
                    "options": {
                      "type": "array",
                      "items": {}
                    }
                  },
                  "required": ["key", "type"]
                }
              }
            },
            "required": ["chartType", "channels", "requiredChannels", "properties"]
          }
        },
        "semanticTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sampleRows": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "frameSummary": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "frameIndex": {
                "type": "integer"
              },
              "refId": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": ["frameIndex", "fields"]
          }
        },
        "conversation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "role": {
                "enum": ["user", "assistant"]
              },
              "content": {
                "type": "string"
              }
            },
            "required": ["role", "content"]
          }
        }
      },
      "required": ["prompt", "fields", "renderBackend", "chartCatalog", "semanticTypes"]
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request": {
          "$ref": "#/$defs/generate"
        },
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "chartType": {
              "type": "string"
            },
            "xField": {
              "type": "string"
            },
            "yField": {
              "type": "string"
            },
            "colorField": {
              "type": "string"
            },
            "specJson": {
              "type": "string"
            },
            "rationale": {
              "type": "string"
            },
            "chartInput": {
              "type": ["object", "null"]
            },
            "seriesColors": {
              "type": ["object", "null"],
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": []
        },
        "compileError": {
          "type": "string"
        },
        "attempt": {
          "const": 1
        }
      },
      "required": ["request", "candidate", "compileError", "attempt"]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/generate"
    },
    {
      "$ref": "#/$defs/repair"
    }
  ]
}
